        "# ========================================\n",
        "# SISTEMA DE PRÉSTAMOS\n",
        "# Versión 3 - Uso de funciones y listas de listas\n",
        "import datetime\n",
        "\n",
        "# Lista de alumnos activos en el sistema\n",
        "alumnos = [\n",
        "    [\"26040200\", \"Superman\", \"Ingenieria en Inteligencia Artificial\"],\n",
        "    [\"26040201\", \"Batman\", \"Ingenieria en Inteligencia Artificial\"],\n",
        "    [\"26040202\", \"Iron Man\", \"Ingenieria en Inteligencia Artificial\"],\n",
        "    [\"26040203\", \"Linterna Verde\", \"Ingenieria Informatica\"],\n",
        "    [\"26040204\", \"Hulk\", \"Ingenieria Informatica\"]\n",
        "]\n",
        "\n",
        "# Lista de computadoras\n",
        "computadoras = [\n",
        "    [\"PC-LC1-01\", \"LC1\", \"Python, VS Code\", \"Disponible\"],\n",
        "    [\"PC-LC1-02\", \"LC1\", \"Python, Java, VS Code\", \"Prestada\"],\n",
        "    [\"PC-LC1-03\", \"LC1\", \"AutoCAD, MATLAB\", \"Reservada\"],\n",
        "    [\"PC-LC2-01\", \"LC2\", \"Python, VS Code\", \"Disponible\"],\n",
        "    [\"PC-LC2-02\", \"LC2\", \"Python, Java, VS Code\", \"Prestada\"],\n",
        "    [\"PC-LC2-03\", \"LC2\", \"AutoCAD, MATLAB\", \"Disponible\"],\n",
        "    [\"PC-LC3-01\", \"LC3\", \"Python, VS Code\", \"Disponible\"],\n",
        "    [\"PC-LC3-02\", \"LC3\", \"Python, Java, VS Code\", \"Prestada\"],\n",
        "    [\"PC-LC3-03\", \"LC3\", \"AutoCAD, MATLAB\", \"Reservada\"],\n",
        "    [\"PC-LC3-04\", \"LC3\", \"Python, VS Code\", \"Mantenimiento\"],\n",
        "]\n",
        "\n",
        "# Lista de prestamos iniciales\n",
        "prestamos = []\n",
        "\n",
        "# Lista de necesidades de software\n",
        "necesidades = []\n",
        "\n",
        "def consultar_computadoras():\n",
        "    print(\"\\n--- COMPUTADORAS ---\")\n",
        "    for i in range(len(computadoras)):\n",
        "        print(\"Aula:\", computadoras[i][1], \"| ID:\", computadoras[i][0], \"| Software:\", computadoras[i][2], \"| Estado:\", computadoras[i][3])\n",
        "\n",
        "def buscar_sw():\n",
        "    programa = input(\"\\nIngrese el software que desea buscar: \")\n",
        "    print(\"\\n--- RESULTADOS ---\")\n",
        "    encontrado = False\n",
        "    for i in range(len(computadoras)):\n",
        "        if programa.lower() in computadoras[i][2].lower():\n",
        "            print(\"ID:\", computadoras[i][0], \" Aulas:\", computadoras[i][1], \"| Software:\", computadoras[i][2], \" Estado:\", computadoras[i][3])\n",
        "            encontrado = True\n",
        "    if not encontrado:\n",
        "        print(\"No se encontraron computadoras con ese software.\")\n",
        "\n",
        "def solicitar_prestamo():\n",
        "    print(\"\\n=== SOLICITAR PRESTAMO ===\")\n",
        "    num_control = input(\"Numero de control del alumno: \")\n",
        "\n",
        "    # Verificar si el alumno existe\n",
        "    alumno_existe = False\n",
        "    for i in range(len(alumnos)):\n",
        "        if num_control == alumnos[i][0]:\n",
        "            alumno_existe = True\n",
        "            break\n",
        "\n",
        "    if alumno_existe:\n",
        "        programa = input(\"Que programa necesita: \")\n",
        "        sw_encontrado = False\n",
        "        pc_asignada = False\n",
        "\n",
        "        for i in range(len(computadoras)):\n",
        "            if programa.lower() in computadoras[i][2].lower():\n",
        "                sw_encontrado = True\n",
        "                if computadoras[i][3] == \"Disponible\":\n",
        "                    computadoras[i][3] = \"Prestada\"\n",
        "                    print(\"Se asignó la computadora\", computadoras[i][0], \"que esta en el aula\", computadoras[i][1])\n",
        "                    historico = [num_control, programa, computadoras[i][1], computadoras[i][0]]\n",
        "                    prestamos.append(historico)\n",
        "                    pc_asignada = True\n",
        "                    break\n",
        "\n",
        "        if sw_encontrado and not pc_asignada:\n",
        "            print(\"El software existe, pero no hay computadoras disponibles en este momento.\")\n",
        "        elif not sw_encontrado:\n",
        "            print(\"No se encontró ese software.\")\n",
        "            opcion2 = input(\"Deseas agregarlo a la lista de necesidades s/n: \")\n",
        "            # Se flexibiliza para aceptar 's', 'si' o 'sí'\n",
        "            if opcion2.lower() in [\"s\", \"si\", \"sí\"]:\n",
        "                fecha_actual = datetime.datetime.now().strftime(\"%d-%m-%Y %H:%M:%S\")\n",
        "                agregar_necesidad = [programa, fecha_actual]\n",
        "                necesidades.append(agregar_necesidad)\n",
        "                print(\"Agregado a la lista de necesidades.\")\n",
        "    else:\n",
        "        print(\"El alumno no existe en la lista.\")\n",
        "\n",
        "def devolver_computadora():\n",
        "    print(\"\\n=== DEVOLVER COMPUTADORA ===\")\n",
        "    id_pc = input(\"Dame el ID de la computadora: \")\n",
        "    existe = False\n",
        "    for i in range(len(computadoras)):\n",
        "        if computadoras[i][0] == id_pc:\n",
        "            existe = True\n",
        "            if computadoras[i][3] == \"Prestada\" or computadoras[i][3] == \"Reservada\":\n",
        "                computadoras[i][3] = \"Disponible\"\n",
        "                print(\"La computadora\", id_pc, \"ya esta disponible\")\n",
        "            else:\n",
        "                print(\"La computadora\", id_pc, \"no esta prestada/reservada\")\n",
        "            break\n",
        "    if not existe:\n",
        "        print(\"No existe la computadora\", id_pc)\n",
        "\n",
        "def agregar_computadora():\n",
        "    print(\"\\n--- AGREGAR COMPUTADORA ---\")\n",
        "    id_computadora = input(\"ID de la computadora: \")\n",
        "    aula = input(\"Aula: \")\n",
        "    programas = input(\"Software instalado: \")\n",
        "    nueva_pc = [id_computadora, aula, programas, \"Disponible\"]\n",
        "    computadoras.append(nueva_pc)\n",
        "    print(\"\\n--- Computadora agregada correctamente ---\")\n",
        "\n",
        "def historial_prestamos():\n",
        "    print(\"\\n--- HISTORIAL DE PRESTAMOS DE COMPUTADORAS ---\")\n",
        "    cantidad_prestamos = len(prestamos)\n",
        "    if cantidad_prestamos > 0:\n",
        "        for i in range(len(prestamos)):\n",
        "            num_control = prestamos[i][0]\n",
        "            nombre_alumno = \"Desconocido\"\n",
        "            carrera_alumno = \"Desconocida\"\n",
        "\n",
        "            # Buscar los detalles del alumno usando el número de control\n",
        "            for j in range(len(alumnos)):\n",
        "                if alumnos[j][0] == num_control:\n",
        "                    nombre_alumno = alumnos[j][1]\n",
        "                    carrera_alumno = alumnos[j][2]\n",
        "                    break\n",
        "\n",
        "            print(i + 1, \" | Alumno:\", nombre_alumno, \"(\" + num_control + \") | Carrera:\", carrera_alumno, \" | Software:\", prestamos[i][1],\n",
        "                  \" | Aula:\", prestamos[i][2], \" | ID:\", prestamos[i][3])\n",
        "    else:\n",
        "        print(\"No se han registrado prestamos\")\n",
        "\n",
        "def estadisticas():\n",
        "    conteo_carreras = []\n",
        "\n",
        "    for i in range(len(prestamos)):\n",
        "        num_control = prestamos[i][0]\n",
        "        carrera = \"\"\n",
        "\n",
        "        for j in range(len(alumnos)):\n",
        "            if alumnos[j][0] == num_control:\n",
        "                carrera = alumnos[j][2]\n",
        "                break\n",
        "\n",
        "        encontrado = False\n",
        "        for k in range(len(conteo_carreras)):\n",
        "            if conteo_carreras[k][0] == carrera:\n",
        "                conteo_carreras[k][1] += 1\n",
        "                encontrado = True\n",
        "                break\n",
        "\n",
        "        if not encontrado and carrera != \"\":\n",
        "            conteo_carreras.append([carrera, 1])\n",
        "\n",
        "    print(\"\\n======= Estadísticas por carrera =======\")\n",
        "    for i in range(len(conteo_carreras)):\n",
        "        print(conteo_carreras[i][0], \":\", conteo_carreras[i][1], \"veces\")\n",
        "\n",
        "    conteo_programas = []\n",
        "\n",
        "    for i in range(len(prestamos)):\n",
        "        programa = prestamos[i][1]\n",
        "        encontrado = False\n",
        "\n",
        "        for j in range(len(conteo_programas)):\n",
        "            if conteo_programas[j][0] == programa:\n",
        "                conteo_programas[j][1] += 1\n",
        "                encontrado = True\n",
        "                break\n",
        "\n",
        "        if not encontrado:\n",
        "            conteo_programas.append([programa, 1])\n",
        "\n",
        "    print(\"\\n======= Estadísticas por programa =======\")\n",
        "    for i in range(len(conteo_programas)):\n",
        "        print(conteo_programas[i][0], \":\", conteo_programas[i][1], \"veces\")\n",
        "\n",
        "def historico_necesidades():\n",
        "    print(\"\\n--- HISTORIAL DE NECESIDADES ---\")\n",
        "    if len(necesidades) > 0:\n",
        "        for i in range(len(necesidades)):\n",
        "            print(i + 1, \" | Programa:\", necesidades[i][0], \"| Fecha:\", necesidades[i][1])\n",
        "    else:\n",
        "        print(\"No hay necesidades registradas.\")\n",
        "\n",
        "# MENÚ PRINCIPAL\n",
        "opcion = 0\n",
        "while opcion != 10:\n",
        "    print(\"\\n================================\")\n",
        "    print(\"      SISTEMA DE PRÉSTAMOS\")\n",
        "    print(\"================================\")\n",
        "    print(\"1. Consultar computadoras\")\n",
        "    print(\"2. Buscar por software\")\n",
        "    print(\"3. Solicitar préstamo\")\n",
        "    print(\"4. Devolver computadora\")\n",
        "    print(\"5. Crear reservación\")\n",
        "    print(\"6. Agregar computadora\")\n",
        "    print(\"7. Historial de prestamos\")\n",
        "    print(\"8. Necesidades de software\")\n",
        "    print(\"9. Estadisticas\")\n",
        "    print(\"10. Salir\")\n",
        "    print(\"================================\")\n",
        "\n",
        "    try:\n",
        "        opcion = int(input(\"Seleccione una opción: \"))\n",
        "    except ValueError:\n",
        "        print(\"\\nPor favor, ingrese un número válido.\")\n",
        "        continue\n",
        "\n",
        "    if opcion == 1:\n",
        "        consultar_computadoras()\n",
        "    elif opcion == 2:\n",
        "        buscar_sw()\n",
        "    elif opcion == 3:\n",
        "        solicitar_prestamo()\n",
        "    elif opcion == 4:\n",
        "        devolver_computadora()\n",
        "    elif opcion == 6:\n",
        "        agregar_computadora()\n",
        "    elif opcion == 7:\n",
        "        historial_prestamos()\n",
        "    elif opcion == 8:\n",
        "        historico_necesidades()\n",
        "    elif opcion == 9:\n",
        "        estadisticas()\n",
        "    elif opcion == 10:\n",
        "        print(\"\\nGracias por utilizar el sistema.\")\n",
        "    else:\n",
        "        print(\"\\nOpción no válida.\")"
      ]
